# Default-deny publication: only reviewed source and documentation enter Git.
/*
!/.gitignore
!/README.md
!/LICENSE
!/devenv.nix
!/devenv.yaml
!/devenv.lock
!/hdt.local.example.json
!/autostart.sh
!/src/
/src/*
!/src/runtime/
!/src/hyprland/
!/src/plugin/
!/src/diagnostics/
/src/runtime/*
!/src/runtime/config.ts
!/src/runtime/launch.ts
!/src/runtime/install-plugin.ts
!/src/runtime/configure-overlay.ts
!/src/runtime/status.ts
/src/hyprland/*
!/src/hyprland/control-input.ts
!/src/hyprland/overlay-rule.ts
!/src/hyprland/overlay-rules.lua
!/src/hyprland/overlay-link.c
/src/plugin/*
!/src/plugin/ProtonCompatibility.cs
/src/diagnostics/*
!/src/diagnostics/surface-check.ts
!/src/diagnostics/window-probe.cs
!/src/diagnostics/x-surface-probe.c
!/scripts/
/scripts/*
!/scripts/autostart.sh
!/scripts/check.sh
!/scripts/setup.sh
!/scripts/steam-launch.sh
!/scripts/steam-options.sh
!/tests/
/tests/*
!/tests/config.test.ts
!/tests/steam-launch.test.ts
!/docs/
/docs/*
!/docs/COMPATIBILITY.md
!/docs/INSTALL.md
!/docs/DEVELOPMENT.md
!/docs/engineering-exception.md
!/docs/specs/
/docs/specs/*
!/docs/specs/publish-compatibility.md
!/docs/specs/automatic-startup.md
!/docs/specs/overlay-stacking.md
!/docs/specs/structured-setup.md
