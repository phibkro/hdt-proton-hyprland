# Default-deny publication: only reviewed source and documentation enter Git.
/*
!/.gitignore
!/README.md
!/LICENSE
!/devenv.nix
!/devenv.yaml
!/devenv.lock
!/config.ts
!/config.test.ts
!/hdt.local.example.json
!/launch.ts
!/autostart.sh
!/control-input.ts
!/overlay-rule.ts
!/overlay-rules.lua
!/ProtonCompatibility.cs
!/install-plugin.ts
!/configure-overlay.ts
!/status.ts
!/window-probe.cs
!/surface-check.ts
!/x-surface-probe.c
!/docs/
/docs/*
!/docs/COMPATIBILITY.md
!/docs/engineering-exception.md
!/docs/specs/
/docs/specs/*
!/docs/specs/publish-compatibility.md
!/docs/specs/automatic-startup.md
