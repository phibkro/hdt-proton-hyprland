root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{c,h,cs,lua}]
indent_size = 4

[*.cs]
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
dotnet_sort_system_directives_first = true

# Public type names are reflection/plugin entry points in the existing HDT host.
[src/{plugin,replay}/*.cs]
dotnet_diagnostic.CA1050.severity = none

[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_size = 4
shell_variant = bash
binary_next_line = true
switch_case_indent = true

[{.envrc,.githooks/pre-commit}]
indent_size = 4
shell_variant = bash
