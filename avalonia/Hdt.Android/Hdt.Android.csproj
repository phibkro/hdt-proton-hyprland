<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>34</SupportedOSPlatformVersion>
    <ApplicationId>org.phibkro.hdt.android</ApplicationId>
    <ApplicationTitle>HDT Android</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' == ''">android-arm64;android-x64</RuntimeIdentifiers>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HdtAndroidFixture)' == 'true' And '$(Configuration)' == 'Debug' And '$(RuntimeIdentifier)' == 'android-x64'">
    <ApplicationId>org.phibkro.hdt.android.fixture</ApplicationId>
    <DefineConstants>$(DefineConstants);HDT_ANDROID_FIXTURE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Hdt.Avalonia/Arena.cs" Link="Shared/Arena.cs" />
    <EmbeddedResource Include="../fixtures/draft.json" LogicalName="Hdt.Mobile.DraftReplay.json" />
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.9" />
  </ItemGroup>
</Project>
