<Project Sdk="Microsoft.NET.Sdk">
  <!-- Analysis only: production still builds with the prefix's Framework compiler. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>5</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)../../cache/nuget</RestorePackagesPath>
    <OutputPath>$(MSBuildThisFileDirectory)../../local/analysis/bin/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="../../src/plugin/FlightRecorder.cs;../../src/diagnostics/*.cs;../../tests/*.cs" />
    <Compile Condition="'$(AnalysisScope)' == 'full'" Include="../../src/plugin/ProtonCompatibility.cs;../../src/replay/*.cs" />
    <Reference Include="System.Drawing;System.Xaml;System.Web.Extensions;PresentationCore;PresentationFramework;WindowsBase" />
  </ItemGroup>
  <ItemGroup Condition="'$(AnalysisScope)' == 'full'">
    <Reference Include="HearthstoneDeckTracker"><HintPath>$(HdtAppDir)/HearthstoneDeckTracker.exe</HintPath></Reference>
    <Reference Include="HearthMirror"><HintPath>$(HdtAppDir)/HearthMirror.dll</HintPath></Reference>
    <Reference Include="MahApps.Metro"><HintPath>$(HdtAppDir)/MahApps.Metro.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(HdtAppDir)/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireOriginalHdt" BeforeTargets="ResolveReferences">
    <Error Condition="'$(AnalysisScope)' != 'core' And '$(AnalysisScope)' != 'full'" Text="Set AnalysisScope explicitly to core or full. Core excludes the HDT-dependent plugin and replay; full requires original HDT assemblies." />
    <Error Condition="'$(AnalysisScope)' == 'full' And !Exists('$(HdtAppDir)/HearthstoneDeckTracker.exe')" Text="Set HdtAppDir to a complete, local HDT installation. Full semantic analysis requires original HDT assemblies; no stubs are used." />
  </Target>
</Project>
